{
  "manifest": {
    "id": "TAMTAM_COMMUNITY_DASHBOARD_V1",
    "name": "TamTam Community Dashboard",
    "type": "immersive_3d_creative_technology_game",
    "version": "1.0.0",
    "status": "implementation_specification",
    "target_user_age": 7,
    "tagline": "Imagine. Grab. Build. Discover.",
    "primary_goal": "Transform curiosity into interactive 3D inventions using hands, physics and real-world making.",
    "experience_rules": [
      "The 3D world is the interface.",
      "No conventional dashboard panels.",
      "No persistent navigation bars.",
      "No intrusive tutorials.",
      "Never punish experimentation.",
      "Every interactive object responds to touch or gesture.",
      "Keep the entire experience child-friendly.",
      "Preserve creative freedom."
    ]
  },
  "platform": {
    "type": "progressive_web_application",
    "priority": ["iPadOS Safari", "Desktop Chrome", "Android Chrome"],
    "framework": "React",
    "language": "TypeScript",
    "reference_runtime": "tamtam/index.html (Three.js + MediaPipe, loads this file)",
    "rendering": {
      "engine": "Three.js",
      "react_adapter": "@react-three/fiber",
      "helpers": "@react-three/drei",
      "physics": "@react-three/rapier",
      "animation": "GSAP",
      "asset_format": "GLB/glTF",
      "graphics_api": "WebGL2",
      "webgpu": "optional_progressive_enhancement"
    },
    "display": {
      "mode": "immersive_fullscreen",
      "preferred_orientation": "landscape",
      "viewport_width": "100%",
      "viewport_height": "100dvh",
      "safe_area_support": true,
      "prevent_page_scroll": true,
      "hide_browser_ui_when_supported": true,
      "fullscreen_request": "user_gesture_required",
      "ios_safari_fallback": "standalone_PWA_or_maximized_viewport",
      "responsive": true,
      "touch_fallback": true
    }
  },
  "visual_identity": {
    "style": "Obsidian-inspired cinematic 3D play space",
    "direction": "Minimal dark environment with luminous, colorful, physically believable 3D objects.",
    "palette": {
      "background": "#07080E",
      "deep_space": "#10121E",
      "violet": "#925BFF",
      "electric_blue": "#27C9FF",
      "neon_pink": "#FF4FC4",
      "solar_yellow": "#FFE65B",
      "mint": "#5BFFD3",
      "coral": "#FF745D",
      "white": "#F7F8FF"
    },
    "environment": {
      "background_type": "infinite_dark_stage",
      "visible_floor": false,
      "visible_walls": false,
      "ambient_particles": true,
      "particle_density": "adaptive_low",
      "depth_fog": true,
      "subtle_parallax": true,
      "camera_default": "perspective",
      "camera_fov_degrees": 42,
      "camera_damping": 0.12,
      "idle_motion": "slow_cinematic_orbit"
    },
    "materials": {
      "primary": "mesh_physical_material",
      "glass": { "transmission": 0.9, "roughness": 0.12, "ior": 1.45 },
      "metal": { "metalness": 0.85, "roughness": 0.22 },
      "soft_plastic": { "metalness": 0.05, "roughness": 0.35 },
      "emissive_accents": true,
      "physically_based_rendering": true
    },
    "lighting": {
      "type": "cinematic_studio",
      "key_light": "large_soft_area",
      "rim_lights": 2,
      "colored_bounce": true,
      "contact_shadows": true,
      "ambient_occlusion": "quality_adaptive",
      "bloom": "selective_subtle",
      "tone_mapping": "ACES",
      "avoid_overexposure": true
    },
    "quality": {
      "preset": "highest_supported_adaptive",
      "desktop_target_fps": 60,
      "tablet_target_fps": 60,
      "mobile_minimum_acceptable_fps": 30,
      "adaptive_resolution": true,
      "device_pixel_ratio_cap": 2,
      "texture_compression": "KTX2",
      "mesh_compression": "Draco_or_Meshopt",
      "asset_preloading": true,
      "instancing": true,
      "level_of_detail": true
    }
  },
  "interface": {
    "home": {
      "layout": "fullscreen_empty_3d_canvas",
      "visible_header": false,
      "visible_sidebar": false,
      "visible_footer": false,
      "visible_buttons_on_idle": false,
      "initial_object": "floating_invention_core",
      "initial_animation": "core_awakens_and_reveals_parts",
      "welcome_voice": "Welcome to your invention world, TamTam.",
      "entry_method": ["tap_core", "pinch_core"]
    },
    "contextual_controls": {
      "appearance": "only_when_needed",
      "style": "floating_glass",
      "dismiss_on_inactivity_seconds": 5,
      "actions": ["undo", "redo", "reset", "save", "help", "exit"]
    },
    "child_accessibility": {
      "large_targets": true,
      "minimum_touch_target_px": 56,
      "voice_instructions": true,
      "visual_hints": true,
      "color_independent_feedback": true,
      "reduced_motion_mode": true,
      "left_hand_support": true,
      "right_hand_support": true,
      "adjustable_tracking_sensitivity": true
    }
  },
  "hand_tracking": {
    "enabled": true,
    "input": "live_device_camera",
    "preferred_engine": "MediaPipe_Hand_Landmarker",
    "runtime": "web",
    "model_mode": "VIDEO",
    "maximum_hands": 2,
    "landmarks_per_hand": 21,
    "world_landmarks": true,
    "handedness_detection": true,
    "tracking_pipeline": {
      "request_camera_permission": true,
      "use_front_camera_by_default": true,
      "mirror_preview": true,
      "normalize_landmarks": true,
      "temporal_smoothing": "One_Euro_Filter",
      "velocity_estimation": true,
      "gesture_confidence_filtering": true,
      "occlusion_grace_period_ms": 250,
      "reacquisition_required_after_loss": true,
      "calibration": "short_interactive_reach_test",
      "camera_intrinsics_calibration": "optional",
      "depth_method": "monocular_estimation_with_virtual_interaction_plane",
      "true_depth_tracking": false
    },
    "performance": {
      "preferred_capture_fps": 60,
      "tracking_target_fps": 30,
      "tracking_high_target_fps": 60,
      "tracking_resolution": { "width": 1280, "height": 720 },
      "adaptive_capture": true,
      "separate_render_and_inference_loops": true,
      "use_worker_when_supported": true,
      "gpu_acceleration_when_supported": true,
      "latency_measurement": true
    },
    "gestures": {
      "hover": { "recognition": "index_fingertip_ray", "effect": "object_glows" },
      "pinch": {
        "recognition": "thumb_index_distance_with_hysteresis",
        "action": "grab_object",
        "threshold": "calibrated_per_hand",
        "minimum_confidence": 0.8
      },
      "release": { "recognition": "pinch_open", "action": "release_or_snap" },
      "drag": { "recognition": "maintained_pinch_with_motion", "action": "move_grabbed_object" },
      "rotate": { "recognition": "pinch_drag_or_two_hand_relative_motion", "action": "rotate_selected_object" },
      "scale": {
        "recognition": "two_hand_distance_change",
        "action": "resize_selected_object",
        "enabled_for": ["design_mode"]
      },
      "explode": {
        "recognition": "two_hand_spread",
        "action": "show_exploded_assembly",
        "requires_selected_assembly": true
      },
      "assemble": { "recognition": "release_near_valid_connector", "action": "magnetic_snap" },
      "disassemble": { "recognition": "pinch_pull_from_connector", "action": "detach_component" },
      "reset": {
        "recognition": "open_palm_hold",
        "hold_duration_ms": 1500,
        "action": "show_reset_confirmation"
      }
    },
    "gesture_state_machine": [
      "NO_HAND", "HAND_DETECTED", "HOVER", "PINCH_CANDIDATE", "GRABBED",
      "DRAGGING", "ROTATING", "RELEASE_PENDING", "SNAPPING", "RELEASED"
    ],
    "interaction_safety": {
      "require_stable_detection": true,
      "gesture_debounce_ms": 150,
      "prevent_accidental_double_grab": true,
      "object_lock_during_snap": true,
      "fallback_on_tracking_loss": "freeze_then_release_safely",
      "touch_controls_always_available": true
    },
    "privacy": {
      "process_video_locally": true,
      "upload_camera_frames": false,
      "record_camera_by_default": false,
      "save_biometric_landmarks": false,
      "camera_off_when_inactive": true,
      "visible_camera_permission_indicator": true,
      "adult_controls_recording": true
    }
  },
  "physics_and_assembly": {
    "physics_engine": "Rapier",
    "gravity": { "x": 0, "y": -9.81, "z": 0 },
    "play_space": {
      "type": "invisible_collision_workspace",
      "bounded": true,
      "soft_boundaries": true,
      "objects_cannot_be_lost": true
    },
    "object_schema": {
      "id": "string",
      "name": "string",
      "mesh_url": "string",
      "material_id": "string",
      "position": [0, 0, 0],
      "rotation": [0, 0, 0],
      "scale": [1, 1, 1],
      "mass": 1,
      "collider": "convex_hull",
      "grabbable": true,
      "detachable": true,
      "connectors": [],
      "educational_description": "string"
    },
    "connector_schema": {
      "id": "string",
      "type": "mechanical_or_electrical",
      "gender": "male_female_or_universal",
      "local_position": [0, 0, 0],
      "local_rotation": [0, 0, 0],
      "compatible_types": [],
      "snap_distance_m": 0.12,
      "snap_angle_degrees": 20,
      "connection_strength": 1
    },
    "assembly_rules": {
      "magnetic_snap": true,
      "connector_validation": true,
      "orientation_alignment": true,
      "snap_preview": "ghost_outline",
      "valid_connection_feedback": "mint_glow_and_soft_click",
      "invalid_connection_feedback": "gentle_resistance",
      "collision_detection": true,
      "detachable_joints": true,
      "exploded_view": true,
      "assembly_history": true,
      "undo_redo": true
    },
    "component_library": [
      "wheels", "gears", "axles", "hinges", "frames", "motors", "batteries",
      "LEDs", "sensors", "switches", "robot_arms", "propellers", "connectors", "decorative_shells"
    ],
    "simulation": {
      "mechanical_motion": true,
      "gear_rotation": true,
      "motor_animation": true,
      "basic_electrical_logic": true,
      "collision_response": true,
      "scientific_accuracy": "age_appropriate_simplified_models",
      "never_claim_unvalidated_physical_accuracy": true
    }
  },
  "gameplay": {
    "core_loop": [
      "Discover an object", "Explore its components", "Disassemble it",
      "Understand how parts work", "Reassemble it", "Change the design",
      "Test the invention", "Save the creation"
    ],
    "worlds": [
      {
        "id": "robot_lab", "name": "Robot Lab", "color": "#925BFF",
        "activities": ["Build a walking robot", "Assemble a robot arm", "Customize a robot companion"]
      },
      {
        "id": "machine_lab", "name": "Machine Lab", "color": "#27C9FF",
        "activities": ["Build a gear machine", "Create a vehicle", "Explore moving mechanisms"]
      },
      {
        "id": "electric_lab", "name": "Electric Lab", "color": "#FFE65B",
        "activities": ["Build a virtual LED circuit", "Connect a motor and switch", "Explore sensors"]
      },
      {
        "id": "invention_lab", "name": "Invention Lab", "color": "#FF4FC4",
        "activities": ["Combine components freely", "Invent a new machine", "Design a printable object"]
      }
    ],
    "rewards": {
      "competitive_leaderboards": false,
      "punitive_failure": false,
      "reward_types": ["new_components", "creative_effects", "discovery_badges", "saved_inventions"],
      "encourage_experimentation": true
    },
    "first_mission": {
      "id": "BUILD_MY_FIRST_ROBOT",
      "name": "My First Robot",
      "difficulty": "beginner",
      "starting_parts": ["robot_body", "left_arm", "right_arm", "left_wheel", "right_wheel", "battery_module"],
      "steps": [
        "Explore the floating robot",
        "Use a pinch to remove one arm",
        "Inspect the connection",
        "Reconnect the arm",
        "Attach the wheels",
        "Insert the battery module",
        "Activate the robot",
        "Watch the robot move"
      ],
      "success_condition": "valid_connections_and_activation",
      "completion_effect": "robot_awakens_with_colorful_particles",
      "free_play_after_completion": true
    }
  },
  "creation_and_export": {
    "project_gallery": {
      "name": "TamTam Inventions",
      "storage": "IndexedDB",
      "autosave": true,
      "thumbnail_generation": true,
      "restore_previous_session": true
    },
    "export": {
      "screenshot_png": true,
      "project_json": true,
      "glb": true,
      "stl": "watertight_geometry_only",
      "three_mf": "future_extension",
      "print_validation": {
        "manifold_check": true,
        "minimum_wall_thickness_mm": 1.2,
        "maximum_overhang_degrees": 45,
        "adult_review_required": true
      }
    }
  },
  "community": {
    "scope": "local_only_in_v1",
    "public_profiles": false,
    "advertising": false,
    "unrestricted_chat": false,
    "external_links": "adult_gated",
    "sharing": "adult_approved_export_only"
  },
  "adult_settings": {
    "gate": "hold_corner_3_seconds_then_simple_sum",
    "controls": [
      "camera_on_off",
      "tracking_sensitivity",
      "language",
      "saved_inventions_manage",
      "export_and_sharing",
      "delete_all_data",
      "session_time_reminder"
    ]
  },
  "localization": {
    "default": "en",
    "supported": ["en", "ar"],
    "rtl": ["ar"],
    "strings": {
      "en": {
        "begin": "Touch the light to begin",
        "welcome": "Welcome to your invention world, TamTam.",
        "snap": "Click! It fits.",
        "awake": "Your robot is awake!",
        "tracking_lost": "I can't see your hand. Show it to the camera."
      },
      "ar": {
        "begin": "المس الضوء لتبدأ",
        "welcome": "أهلاً بك في عالم اختراعاتك يا تمتم.",
        "snap": "تَكّ! تركّبت.",
        "awake": "الروبوت استيقظ!",
        "tracking_lost": "ما أقدر أشوف إيدك. وريها للكاميرا."
      }
    }
  },
  "audio": {
    "spoken_instructions": true,
    "voice": "system_speech_synthesis",
    "sfx": ["grab_soft", "detach_pop", "snap_click", "robot_awake_chime"],
    "music": "optional_ambient_low",
    "master_volume": 0.7
  },
  "runtime_defaults": {
    "pinch_close_ratio": 0.28,
    "pinch_open_ratio": 0.42,
    "reach_window": { "x0": 0.1, "x1": 0.9, "y0": 0.1, "y1": 0.9 },
    "one_euro": { "min_cutoff": 1.4, "beta": 0.03, "d_cutoff": 1.0 },
    "detach_pull_distance": 0.45,
    "snap_distance": 0.9,
    "explode_spread_min": 0.35,
    "explode_spread_max": 0.8,
    "explode_factor": 1.1,
    "reset_hold_ms": 1500,
    "grab_pick_radius_px": 36,
    "mediapipe": {
      "bundle": "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs",
      "wasm": "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm",
      "model": "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",
      "min_detection_confidence": 0.6,
      "min_tracking_confidence": 0.6
    }
  },
  "scene": {
    "camera_position": [0, 0.4, 7.5],
    "assembly_origin": [0, 0, 0],
    "parts": [
      {
        "id": "robot_body", "name": "Body", "role": "root",
        "shape": "box", "size": [1.5, 1.9, 1.1],
        "color": "violet", "material": "soft_plastic", "emissive": 0.18,
        "position": [0, 0.2, 0],
        "info": "The body holds everything together."
      },
      {
        "id": "left_arm", "name": "Left Arm", "shape": "cylinder", "size": [0.2, 0.2, 1.2],
        "color": "electric_blue", "material": "metal", "emissive": 0.2,
        "socket": [-1.05, 0.35, 0], "mesh_rotation": [0, 0, 0],
        "info": "Arms reach and lift."
      },
      {
        "id": "right_arm", "name": "Right Arm", "shape": "cylinder", "size": [0.2, 0.2, 1.2],
        "color": "coral", "material": "metal", "emissive": 0.2,
        "socket": [1.05, 0.35, 0], "mesh_rotation": [0, 0, 0],
        "info": "Two arms are better than one."
      },
      {
        "id": "left_wheel", "name": "Left Wheel", "shape": "cylinder", "size": [0.5, 0.5, 0.3],
        "color": "solar_yellow", "material": "soft_plastic", "emissive": 0.25,
        "socket": [-0.75, -1.1, 0.2], "mesh_rotation": [0, 0, 1.5708], "spin": true,
        "info": "Wheels turn to make things move."
      },
      {
        "id": "right_wheel", "name": "Right Wheel", "shape": "cylinder", "size": [0.5, 0.5, 0.3],
        "color": "solar_yellow", "material": "soft_plastic", "emissive": 0.25,
        "socket": [0.75, -1.1, 0.2], "mesh_rotation": [0, 0, 1.5708], "spin": true,
        "info": "Both wheels turn together."
      },
      {
        "id": "battery_module", "name": "Battery", "shape": "box", "size": [0.6, 0.6, 0.35],
        "color": "mint", "material": "glass", "emissive": 0.55,
        "socket": [0, 0.25, 0.72], "mesh_rotation": [0, 0, 0],
        "info": "The battery gives the robot energy."
      }
    ]
  },
  "acceptance_criteria": [
    "Full screen with an empty dark canvas on load; no persistent panels.",
    "Pinch grabs, drags, pulls parts off and snaps them back on.",
    "Two open hands spreading apart explodes the assembly; closing brings it back.",
    "Touch and mouse give the same results as hands at all times.",
    "Completing the robot triggers the awake animation and spinning wheels.",
    "No camera frame is stored or uploaded."
  ]
}
